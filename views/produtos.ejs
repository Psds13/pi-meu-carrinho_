<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resultados de Busca - Meu Carrinho</title>
  <meta name="description" content="Resultados da sua pesquisa de produtos e comparação de preços nos supermercados.">
  <link rel="icon" type="image/png" href="/image/logo.png">
  <link rel="stylesheet" href="/main-responsive.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container py-5">
    <div class="mb-4">
      <span class="badge-tag bg-success-light text-success mb-2"><i class="bi bi-search"></i> Resultados de Pesquisa</span>
      <h1>Resultados para "<%= query %>"</h1>
      <p class="text-muted"><%= produtos.length %> produto(s) encontrado(s)</p>
    </div>

    <% if (produtos.length > 0) { %>
      <div class="products-responsive-grid">
        <% produtos.forEach(p => { %>
          <div class="product-card-modern" data-category="<%= p.categoria %>" data-market="<%= p.mercado_principal || p.mercado_nome || '' %>">
            <div class="product-card-top">
              <% if (p.desconto && p.desconto > 0) { %>
                <span class="discount-tag-badge">-<%= p.desconto %>%</span>
              <% } else { %>
                <span></span>
              <% } %>
              <button class="btn-favorite-heart" data-id="<%= p.id %>">
                <i class="bi bi-heart"></i>
              </button>
            </div>

            <div class="product-image-box">
              <img src="<%= p.imagem %>" alt="<%= p.nome %>" loading="lazy">
            </div>

            <div class="product-meta-store">
              <span class="badge-tag <%= (p.mercado_principal || p.mercado_nome || 'Atacadão').toLowerCase().replace('í','i').replace('ã','a') %>">
                <%= p.mercado_principal || p.mercado_nome || 'Atacadão' %>
              </span>
            </div>

            <h3 class="product-name-title"><%= p.nome %></h3>
            <p class="product-weight-label"><%= p.marca || '' %> • <%= p.quantidade_peso || '' %></p>

            <div class="product-prices-box">
              <% if (p.preco_anterior && p.preco_anterior > p.preco_atual) { %>
                <span class="price-previous">R$ <%= parseFloat(p.preco_anterior).toFixed(2).replace('.',',') %></span>
              <% } %>
              <span class="price-current">R$ <%= parseFloat(p.preco_atual || p.preco).toFixed(2).replace('.',',') %></span>
            </div>

            <div class="product-actions-box">
              <button class="btn btn-add-cart-full" 
                data-id="<%= p.id %>"
                data-nome="<%= p.nome %>"
                data-preco="<%= p.preco_atual || p.preco %>"
                data-imagem="<%= p.imagem %>"
                data-mercado="<%= p.mercado_principal || p.mercado_nome || 'Atacadão' %>">
                <i class="bi bi-cart-plus-fill"></i> Adicionar à Lista
              </button>

              <button class="btn-compare-product" data-id="<%= p.id %>">
                <i class="bi bi-arrow-left-right"></i> Compare este produto
              </button>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state text-center py-5">
        <i class="bi bi-search" style="font-size: 4rem; color: var(--text-muted);"></i>
        <h3 class="mt-3">Nenhum produto encontrado</h3>
        <p class="text-muted">Não encontramos resultados para "<%= query %>". Tente buscar por outros termos como arroz, leite, café ou feijão.</p>
        <a href="/" class="btn btn-primary mt-3">Voltar à Página Inicial</a>
      </div>
    <% } %>
  </main>

  <%- include('partials/modals') %>
  <%- include('partials/footer') %>

  <script src="/js/app-main.js"></script>
</body>
</html>
