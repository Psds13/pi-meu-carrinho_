<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meu Carrinho - Compare Preços de Supermercados e Economize</title>
  <meta name="description" content="Compare preços nos supermercados Atacadão, Assaí e Mateus. Monte sua lista de compras e compre nos canais oficiais.">
  <link rel="icon" type="image/png" href="/image/logo.png">
  <link rel="stylesheet" href="/main-responsive.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<body>
  <!-- Header Top Navigation -->
  <%- include('partials/header') %>

  <main>
    <!-- HERO PRINCIPAL REFORMULADO -->
    <section class="hero-intro-section">
      <div class="container hero-layout">
        <div class="hero-content-left">
          <div class="hero-badge-tag">
            <i class="bi bi-piggy-bank-fill"></i> Plataforma #1 de Economia em Supermercados
          </div>
          <h1 class="hero-headline">
            Compare preços. <br>
            Monte sua lista. <br>
            <span>Economize de verdade.</span>
          </h1>
          <p class="hero-subtitle">
            Encontre os melhores preços nos supermercados da sua região e descubra exatamente onde sua compra inteira fica mais barata.
          </p>

          <!-- Campo de Pesquisa Grande Hero -->
          <form action="/produtos" method="get" class="hero-search-box">
            <input type="text" name="search" placeholder="Pesquise por produto" class="hero-search-input" required>
            <button type="submit" class="btn btn-primary hero-search-btn">
              <i class="bi bi-search"></i> Buscar Preços
            </button>
          </form>

          <div class="hero-shortcuts">
            <span>Atalho rápido:</span>
            <a href="/minha-lista" class="btn-shortcut-list">
              <i class="bi bi-cart-plus-fill"></i> Montar minha lista de compras <i class="bi bi-arrow-right"></i>
            </a>
          </div>

          <!-- Indicadores de Impacto -->
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-icon"><i class="bi bi-box-seam-fill"></i></div>
              <div class="stat-info">
                <strong>100+</strong>
                <span>Produtos Cadastrados</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-icon"><i class="bi bi-shop-window"></i></div>
              <div class="stat-info">
                <strong>3 Grandes</strong>
                <span>Supermercados Comparados</span>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-icon"><i class="bi bi-graph-down-arrow"></i></div>
              <div class="stat-info">
                <strong>Até 50%</strong>
                <span>De Economia Real</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Banner Slider Slideshow Integrado -->
        <div class="hero-content-right">
          <div class="banner-slider-box">
            <div class="banner-slides-wrapper">
              <div class="banner-slide active">
                <img src="/image/slide01.png" alt="Super Oferta 1">
              </div>
              <div class="banner-slide">
                <img src="/image/slide02.png" alt="Super Oferta 2">
              </div>
              <div class="banner-slide">
                <img src="/image/slide03.png" alt="Super Oferta 3">
              </div>
            </div>
            <div class="banner-dots">
              <span class="banner-dot active" onclick="setSlide(0)"></span>
              <span class="banner-dot" onclick="setSlide(1)"></span>
              <span class="banner-dot" onclick="setSlide(2)"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SELEÇÃO DE SUPERMERCADOS COM MULTI-SELEÇÃO -->
    <section id="supermarkets-section" class="supermarkets-section container">
      <div class="section-header">
        <div class="section-header-title">
          <h2>Supermercados da Sua Região</h2>
          <p>Selecione um ou mais supermercados para comparar preços lado a lado</p>
        </div>
        <a href="/mercados" class="btn btn-outline-nav btn-sm">Ver todos os detalhes <i class="bi bi-arrow-right"></i></a>
      </div>

      <div class="supermarkets-grid">
        <!-- Card Atacadão -->
        <div class="supermarket-card" id="card-atacadao">
          <div class="market-card-top">
            <div class="market-logo-wrapper">
              <img src="/image/atacadao-logo2.webp" alt="Atacadão">
            </div>
            <label class="market-checkbox-wrapper">
              <input type="checkbox" class="market-select-checkbox" value="Atacadão">
              <span>Comparar</span>
            </label>
          </div>
          <h3 class="market-name-title">Atacadão</h3>
          <ul class="market-meta-list">
            <li><i class="bi bi-tag-fill"></i> <strong>24+ Ofertas Ativas</strong></li>
            <li><i class="bi bi-currency-dollar"></i> Preços a partir de <strong>R$ 2,99</strong></li>
            <li><i class="bi bi-shield-check text-success"></i> Canal Oficial Verificado</li>
          </ul>
          <div class="market-card-footer d-flex gap-2">
            <a href="/atacadao" class="btn btn-secondary w-50">Ver Ofertas</a>
            <button class="btn btn-outline-nav btn-sm w-50 btn-buy-official-store" data-mercado="Atacadão" data-url="https://www.atacadao.com.br/">
              Ir ao Site <i class="bi bi-box-arrow-up-right"></i>
            </button>
          </div>
        </div>

        <!-- Card Assaí -->
        <div class="supermarket-card" id="card-assai">
          <div class="market-card-top">
            <div class="market-logo-wrapper">
              <img src="/image/assaí-logo.png" alt="Assaí Atacadista">
            </div>
            <label class="market-checkbox-wrapper">
              <input type="checkbox" class="market-select-checkbox" value="Assaí">
              <span>Comparar</span>
            </label>
          </div>
          <h3 class="market-name-title">Assaí Atacadista</h3>
          <ul class="market-meta-list">
            <li><i class="bi bi-tag-fill"></i> <strong>26+ Ofertas Ativas</strong></li>
            <li><i class="bi bi-currency-dollar"></i> Preços a partir de <strong>R$ 1,99</strong></li>
            <li><i class="bi bi-shield-check text-success"></i> Canal Oficial Verificado</li>
          </ul>
          <div class="market-card-footer d-flex gap-2">
            <a href="/assai" class="btn btn-secondary w-50">Ver Ofertas</a>
            <button class="btn btn-outline-nav btn-sm w-50 btn-buy-official-store" data-mercado="Assaí" data-url="https://www.assai.com.br/">
              Ir ao Site <i class="bi bi-box-arrow-up-right"></i>
            </button>
          </div>
        </div>

        <!-- Card Mateus -->
        <div class="supermarket-card" id="card-mateus">
          <div class="market-card-top">
            <div class="market-logo-wrapper">
              <img src="/image/grupo-mateus-logo.png" alt="Grupo Mateus">
            </div>
            <label class="market-checkbox-wrapper">
              <input type="checkbox" class="market-select-checkbox" value="Mateus">
              <span>Comparar</span>
            </label>
          </div>
          <h3 class="market-name-title">Grupo Mateus</h3>
          <ul class="market-meta-list">
            <li><i class="bi bi-tag-fill"></i> <strong>30+ Ofertas Ativas</strong></li>
            <li><i class="bi bi-currency-dollar"></i> Preços a partir de <strong>R$ 1,99</strong></li>
            <li><i class="bi bi-shield-check text-success"></i> Canal Oficial Verificado</li>
          </ul>
          <div class="market-card-footer d-flex gap-2">
            <a href="/mateus" class="btn btn-secondary w-50">Ver Ofertas</a>
            <button class="btn btn-outline-nav btn-sm w-50 btn-buy-official-store" data-mercado="Mateus" data-url="https://www.mateusmais.com.br/">
              Ir ao Site <i class="bi bi-box-arrow-up-right"></i>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- SEÇÃO HORIZONTAL DE CATEGORIAS -->
    <section class="categories-section container">
      <div class="section-header mb-3">
        <h2>Filtrar por Categoria</h2>
      </div>

      <div class="categories-pills-wrapper">
        <button class="cat-pill active" data-category="Todos"><i class="bi bi-grid-fill"></i> Todos os Produtos</button>
        <button class="cat-pill" data-category="Alimentos"><i class="bi bi-egg-fill"></i> Alimentos</button>
        <button class="cat-pill" data-category="Bebidas"><i class="bi bi-cup-straw"></i> Bebidas</button>
        <button class="cat-pill" data-category="Carnes"><i class="bi bi-tag-fill"></i> Carnes</button>
        <button class="cat-pill" data-category="Hortifruti"><i class="bi bi-apple"></i> Hortifruti</button>
        <button class="cat-pill" data-category="Laticínios"><i class="bi bi-cup-hot-fill"></i> Laticínios</button>
        <button class="cat-pill" data-category="Limpeza"><i class="bi bi-sparkles"></i> Limpeza</button>
        <button class="cat-pill" data-category="Higiene"><i class="bi bi-shield-plus"></i> Higiene</button>
        <button class="cat-pill" data-category="Mercearia"><i class="bi bi-basket-fill"></i> Mercearia</button>
        <button class="cat-pill" data-category="Congelados"><i class="bi bi-snow"></i> Congelados</button>
      </div>
    </section>

    <!-- CATALOGO DE PRODUTOS DESTACADOS -->
    <section class="products-grid-section container">
      <div class="section-header">
        <h2>Produtos e Comparativo de Preços</h2>
        <p>Clique em "Compare este produto" ou "Comprar no site oficial" para concluir sua compra</p>
      </div>

      <div class="products-responsive-grid" id="mainProductsGrid">
        <% if (typeof produtos !== 'undefined' && produtos.length > 0) { %>
          <% produtos.forEach(p => { %>
            <div class="product-card-modern" data-category="<%= p.categoria %>" data-market="<%= p.mercado_principal %>">
              <div class="product-card-top">
                <% if (p.desconto && p.desconto > 0) { %>
                  <span class="discount-tag-badge">-<%= p.desconto %>%</span>
                <% } else { %>
                  <span></span>
                <% } %>
                <button class="btn-favorite-heart" data-id="<%= p.id %>" title="Favoritar Produto">
                  <i class="bi bi-heart"></i>
                </button>
              </div>

              <div class="product-image-box">
                <img src="<%= p.imagem %>" alt="<%= p.nome %>" loading="lazy">
              </div>

              <div class="product-meta-store">
                <span class="badge-tag <%= p.mercado_principal.toLowerCase().replace('í','i').replace('ã','a') %>"><%= p.mercado_principal %></span>
              </div>

              <h3 class="product-name-title"><%= p.nome %></h3>
              <p class="product-weight-label"><%= p.marca || '' %> • <%= p.quantidade_peso || '' %></p>

              <div class="product-prices-box">
                <% if (p.preco_anterior && p.preco_anterior > p.preco_atual) { %>
                  <span class="price-previous">R$ <%= parseFloat(p.preco_anterior).toFixed(2).replace('.',',') %></span>
                <% } %>
                <span class="price-current">R$ <%= parseFloat(p.preco_atual).toFixed(2).replace('.',',') %></span>
                
                <% if (p.valor_economizado && p.valor_economizado > 0) { %>
                  <div>
                    <span class="savings-label-badge"><i class="bi bi-check-circle-fill"></i> Economiza R$ <%= parseFloat(p.valor_economizado).toFixed(2).replace('.',',') %></span>
                  </div>
                <% } %>
              </div>

              <div class="product-actions-box">
                <button class="btn btn-add-cart-full" 
                  data-id="<%= p.id %>"
                  data-nome="<%= p.nome %>"
                  data-preco="<%= p.preco_atual %>"
                  data-imagem="<%= p.imagem %>"
                  data-mercado="<%= p.mercado_principal %>"
                  data-peso="<%= p.quantidade_peso %>">
                  <i class="bi bi-cart-plus-fill"></i> Adicionar à Lista
                </button>

                <button class="btn btn-outline-nav btn-sm btn-buy-official-store" 
                  data-mercado="<%= p.mercado_principal %>"
                  data-nome="<%= p.nome %>"
                  data-url="<%= p.url_oficial || '' %>">
                  <i class="bi bi-box-arrow-up-right"></i> Comprar no <%= p.mercado_principal %>
                </button>

                <button class="btn-compare-product" data-id="<%= p.id %>">
                  <i class="bi bi-arrow-left-right"></i> Compare este produto
                </button>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </section>
  </main>

  <!-- Modals Incluídos -->
  <%- include('partials/modals') %>

  <!-- Footer Incluído -->
  <%- include('partials/footer') %>

  <script src="/js/app-main.js"></script>
  <script>
    // Simple Slider Logic for Hero Banner
    let currentSlideIndex = 0;
    const slides = document.querySelectorAll('.banner-slide');
    const dots = document.querySelectorAll('.banner-dot');

    function setSlide(index) {
      if (!slides.length) return;
      slides.forEach(s => s.classList.remove('active'));
      dots.forEach(d => d.classList.remove('active'));
      currentSlideIndex = index;
      slides[currentSlideIndex].classList.add('active');
      dots[currentSlideIndex].classList.add('active');
    }

    setInterval(() => {
      if (slides.length > 0) {
        let next = (currentSlideIndex + 1) % slides.length;
        setSlide(next);
      }
    }, 4500);
  </script>
</body>
</html>