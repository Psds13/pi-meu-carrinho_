<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meus Favoritos - Meu Carrinho</title>
  <meta name="description" content="Seus produtos salvos e favoritados no Meu Carrinho. Acompanhe preços e adicione à lista a qualquer momento.">
  <link rel="icon" type="image/png" href="/image/logo.png">
  <link rel="stylesheet" href="/main-responsive.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container py-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <span class="badge-tag bg-danger-light text-danger mb-2"><i class="bi bi-heart-fill"></i> Produtos Salvos</span>
        <h1>Meus Favoritos</h1>
        <p class="text-muted">Acompanhe seus produtos favoritos e adicione rapidamente à sua lista de compras.</p>
      </div>
    </div>

    <div class="products-responsive-grid" id="favoritesGridContainer">
      <!-- Dynamic render via JavaScript based on LocalStorage fav IDs -->
    </div>
  </main>

  <%- include('partials/modals') %>
  <%- include('partials/footer') %>

  <script src="/js/app-main.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const favs = JSON.parse(localStorage.getItem('mc_favs') || '[]');
      const container = document.getElementById('favoritesGridContainer');
      if (!container) return;

      if (favs.length === 0) {
        container.innerHTML = `
          <div class="empty-state text-center py-5" style="grid-column: 1 / -1;">
            <i class="bi bi-heart" style="font-size: 3.5rem; color: var(--text-muted);"></i>
            <h3 class="mt-3">Nenhum produto favoritado ainda</h3>
            <p class="text-muted">Clique no coração de qualquer produto para salvá-lo aqui.</p>
            <a href="/" class="btn btn-primary mt-3">Explorar Produtos</a>
          </div>
        `;
        return;
      }

      try {
        const res = await fetch('/api/products');
        const data = await res.json();
        if (data.success && data.data) {
          const favoriteProducts = data.data.filter(p => favs.includes(String(p.id)) || favs.includes(p.id));

          if (favoriteProducts.length === 0) {
            container.innerHTML = `<p class="text-muted text-center">Nenhum produto favoritado encontrado.</p>`;
            return;
          }

          container.innerHTML = favoriteProducts.map(p => `
            <div class="product-card-modern">
              <div class="product-card-top">
                ${p.desconto > 0 ? `<span class="discount-tag-badge">-${p.desconto}%</span>` : '<span></span>'}
                <button class="btn-favorite-heart active" data-id="${p.id}" title="Remover dos Favoritos">
                  <i class="bi bi-heart"></i>
                </button>
              </div>

              <div class="product-image-box">
                <img src="${p.imagem}" alt="${p.nome}">
              </div>

              <div class="product-meta-store">
                <span class="badge-tag ${p.mercado_principal.toLowerCase().replace('í','i').replace('ã','a')}">${p.mercado_principal}</span>
              </div>

              <h3 class="product-name-title">${p.nome}</h3>
              <p class="product-weight-label">${p.marca || ''} • ${p.quantidade_peso || ''}</p>

              <div class="product-prices-box">
                ${p.preco_anterior && p.preco_anterior > p.preco_atual ? `<span class="price-previous">R$ ${parseFloat(p.preco_anterior).toFixed(2).replace('.',',')}</span>` : ''}
                <span class="price-current">R$ ${parseFloat(p.preco_atual).toFixed(2).replace('.',',')}</span>
              </div>

              <div class="product-actions-box">
                <button class="btn btn-add-cart-full" 
                  data-id="${p.id}"
                  data-nome="${p.nome}"
                  data-preco="${p.preco_atual}"
                  data-imagem="${p.imagem}"
                  data-mercado="${p.mercado_principal}">
                  <i class="bi bi-cart-plus-fill"></i> Adicionar à Lista
                </button>
              </div>
            </div>
          `).join('');
        }
      } catch (e) {
        console.error(e);
      }
    });
  </script>
</body>
</html>
