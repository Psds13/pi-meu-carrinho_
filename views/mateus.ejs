<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grupo Mateus - Meu Carrinho</title>
  <meta name="description" content="Confira todas as ofertas atualizadas do Grupo Mateus na sua região e compare preços.">
  <link rel="icon" type="image/png" href="/image/logo.png">
  <link rel="stylesheet" href="/main-responsive.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container py-5">
    <div class="card p-4 mb-4 text-center" style="background: linear-gradient(135deg, var(--mateus-bg) 0%, var(--bg-card) 100%); border: 1px solid var(--border-color); border-radius: var(--radius-lg);">
      <img src="/image/grupo-mateus-logo.png" alt="Grupo Mateus" style="height: 70px; width: auto; margin: 0 auto 1rem; object-fit: contain;">
      <h2>Ofertas Grupo Mateus</h2>
      <p class="text-muted">Faz parte da sua vida. As melhores marcas e variedades para você e sua família.</p>
    </div>

    <!-- Filtro por Supermercados Alternativos -->
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h3 class="mb-0">Produtos no Mateus</h3>
      <div class="d-flex gap-2">
        <span class="text-muted small me-2">Ver outros mercados:</span>
        <a href="/atacadao" class="badge-tag atacadao">Atacadão</a>
        <a href="/assai" class="badge-tag assai">Assaí</a>
      </div>
    </div>

    <div class="products-responsive-grid">
      <% if (typeof produtos !== 'undefined' && produtos.length > 0) { %>
        <% produtos.forEach(p => { %>
          <div class="product-card-modern">
            <div class="product-card-top">
              <% if (p.desconto && p.desconto > 0) { %>
                <span class="discount-tag-badge">-<%= p.desconto %>%</span>
              <% } else { %>
                <span></span>
              <% } %>
              <button class="btn-favorite-heart" data-id="<%= p.id %>">
                <i class="bi bi-heart"></i>
              </button>
            </div>

            <div class="product-image-box">
              <img src="<%= p.imagem %>" alt="<%= p.nome %>" loading="lazy">
            </div>

            <div class="product-meta-store">
              <span class="badge-tag mateus">Mateus</span>
            </div>

            <h3 class="product-name-title"><%= p.nome %></h3>
            <p class="product-weight-label"><%= p.marca || '' %> • <%= p.quantidade_peso || '' %></p>

            <div class="product-prices-box">
              <% if (p.preco_anterior && p.preco_anterior > p.preco_atual) { %>
                <span class="price-previous">R$ <%= parseFloat(p.preco_anterior).toFixed(2).replace('.',',') %></span>
              <% } %>
              <span class="price-current">R$ <%= parseFloat(p.preco_atual).toFixed(2).replace('.',',') %></span>
            </div>

            <div class="product-actions-box">
              <button class="btn btn-add-cart-full" 
                data-id="<%= p.id %>"
                data-nome="<%= p.nome %>"
                data-preco="<%= p.preco_atual %>"
                data-imagem="<%= p.imagem %>"
                data-mercado="Mateus">
                <i class="bi bi-cart-plus-fill"></i> Adicionar à Lista
              </button>

              <button class="btn-compare-product" data-id="<%= p.id %>">
                <i class="bi bi-arrow-left-right"></i> Compare este produto
              </button>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>

  <%- include('partials/modals') %>
  <%- include('partials/footer') %>

  <script src="/js/app-main.js"></script>
</body>
</html>